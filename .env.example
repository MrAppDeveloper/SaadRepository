# Copy to .env and fill in. Never commit .env.
#
# Paid providers are OFF unless listed here. A key alone does not enable anything.
# anthropic     = metered Anthropic API billing (NOT your Claude Code subscription).
# claude_cli    = runs `claude -p` using your Claude Code login (subscription limits);
#                 text-only, and ANTHROPIC_API_KEY is removed from its environment.
# openai_compat = whatever your server charges.
NEBULA_AGENT_ENABLE=

ANTHROPIC_API_KEY=
# Any OpenAI-compatible server (/chat/completions).
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
# Nebula API details are not verified yet; the adapter is a stub and ignores these.
NEBULA_API_KEY=
NEBULA_BASE_URL=
